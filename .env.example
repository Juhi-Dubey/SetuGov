# =================================================================
# SetuGov Unified Deployment Configuration Template (.env.example)
# =================================================================
# Copy this file to .env for local development or production deployment.
# Fill in real values locally or in your secrets manager.
# NEVER commit real credentials to Git.

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=setugov_db
# For local Node.js: postgresql://postgres:your_postgres_password_here@localhost:5432/setugov_db?schema=public
# For Docker network: postgresql://postgres:your_postgres_password_here@postgres:5432/setugov_db?schema=public
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/setugov_db?schema=public

# --- Authentication & Security ---
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
BANK_ENCRYPTION_KEY=replace_with_32_byte_aes_encryption_key

# --- Node.js Backend API ---
PORT=5000
NODE_ENV=development

# --- Python AI Decision-Support Service (Brain 1-5) ---
# For local backend -> AI: http://localhost:8000
# For Docker network: http://ai:8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_MOCK_MODE=true

# --- Ollama & LLM Configuration ---
# Canonical Model: llama3.2:3b
# For local AI -> Ollama: http://localhost:11434
# For Docker network: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# --- Logging & Observability ---
LOG_LEVEL=INFO
