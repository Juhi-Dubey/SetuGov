# =================================================================
# SetuGov Unified Deployment Configuration
# =================================================================
# Copy this file to .env at project root for Docker Compose
# or to individual service directories for local development.

# --- PostgreSQL Database ---
# Note: Native pgvector is deferred to future scope.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=setugov_db
# For local Node.js: postgresql://postgres:postgres@localhost:5432/setugov_db?schema=public
# For Docker network: postgresql://postgres:postgres@postgres:5432/setugov_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/setugov_db?schema=public

# --- Authentication & Security ---
JWT_SECRET=setugov_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# --- Node.js Backend API ---
PORT=5000
NODE_ENV=development

# --- Python AI Decision-Support Service (Brain 1-5) ---
# For local backend -> AI: http://localhost:8000
# For Docker network: http://ai:8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_MOCK_MODE=true

# --- Ollama & LLM Configuration ---
# Canonical Model: llama3.2:3b
# For local AI -> Ollama: http://localhost:11434
# For Docker network: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# --- Logging & Observability ---
LOG_LEVEL=INFO
