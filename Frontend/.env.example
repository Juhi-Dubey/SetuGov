# SetuGov Frontend Environment Configuration Template (.env.example)
VITE_API_URL="http://localhost:5000/api/v1"
VITE_API_BASE_URL="http://localhost:5000/api/v1"

# Cloudflare Turnstile Public Site Key (Optional for local dev, configure in production)
# Note: Turnstile Site Key is a public browser key, not a secret.
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here