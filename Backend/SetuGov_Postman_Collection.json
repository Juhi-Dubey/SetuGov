    {
      "name": "03 - Challenges & Matching",
      "item": [
        {
          "name": "List Challenges",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challenges?status=PUBLISHED",
              "host": ["{{baseUrl}}"],
              "path": ["challenges"],
              "query": [
                { "key": "status", "value": "PUBLISHED" }
              ]
            }
          }
        },
        {
          "name": "Create Challenge (DRAFT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"AI-Powered Traffic Flow Optimization for Metro Corridors\",\n  \"problem_statement\": \"Peak hour congestion in central corridors exceeds capacity by 45%.\",\n  \"expected_outcome\": \"Adaptive real-time signal timing reducing commute delay by at least 25%.\",\n  \"domain\": \"Urban Mobility\",\n  \"target_sector\": \"Smart Cities\",\n  \"budget\": 1200000,\n  \"trl_required\": 6,\n  \"submission_deadline\": \"2026-10-30T18:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challenges",
              "host": ["{{baseUrl}}"],
              "path": ["challenges"]
            }
          }
        }
      ]
