# SetuGov Backend Environment Configuration Template (.env.example)
PORT=5000
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/setugov_db?schema=public"
JWT_SECRET="replace_with_strong_random_secret_min_32_chars"
JWT_EXPIRES_IN="7d"
# Bank Account Encryption (AES-256-GCM). Generate with: openssl rand -hex 32
# Required in production (server will exit if missing). Fallback key used only in development.
BANK_ENCRYPTION_KEY="replace_with_32_byte_aes_encryption_key"
AI_SERVICE_URL="http://localhost:8000"
# Set AI_MOCK_MODE=false for real AI inference in production, or true for offline mock development/testing
AI_MOCK_MODE=false
NODE_ENV="development"
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB=setugov_db

# AI Embeddings (Expected vector dimension for Postgres pgvector validation)
# Note: Actual AI provider and embedding model are configured on the AI service side (see AI/.env.example), not here.
AI_EMBEDDING_DIMENSION=768

# Anti-Abuse & Rate Limiting
AUTH_RATE_LIMIT_MAX=15
AUTH_RATE_LIMIT_WINDOW_MS=900000
INVITATION_RATE_LIMIT_MAX=20
INVITATION_RATE_LIMIT_WINDOW_MS=900000
ACCESS_REQUEST_RATE_LIMIT_MAX=5

# Cloudflare Turnstile CAPTCHA (disabled in local dev, enabled in production)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
TURNSTILE_EXPECTED_HOSTNAME=

# Email Delivery Service
# Supported EMAIL_PROVIDER values: 'smtp', 'resend', 'sendgrid', 'console'
EMAIL_PROVIDER=smtp
EMAIL_FROM="SetuGov Platform <your_email@gmail.com>"
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# Fallback for Resend/SendGrid if used
EMAIL_API_KEY=

