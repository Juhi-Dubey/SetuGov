# SetuGov Backend Environment Configuration Template (.env.example)
PORT=5000
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/setugov_db?schema=public"
JWT_SECRET="replace_with_strong_random_secret_min_32_chars"
JWT_EXPIRES_IN="7d"
BANK_ENCRYPTION_KEY="replace_with_32_byte_aes_encryption_key"
AI_SERVICE_URL="http://localhost:8000"
AI_MOCK_MODE=true
NODE_ENV="development"
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB=setugov_db

# Ollama & Embeddings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_EMBEDDING_DIMENSION="768"

# Anti-Abuse & Rate Limiting
AUTH_RATE_LIMIT_MAX=15
AUTH_RATE_LIMIT_WINDOW_MS=900000
INVITATION_RATE_LIMIT_MAX=20
INVITATION_RATE_LIMIT_WINDOW_MS=900000
ACCESS_REQUEST_RATE_LIMIT_MAX=5

# Cloudflare Turnstile CAPTCHA (disabled in local dev, enabled in production)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
TURNSTILE_EXPECTED_HOSTNAME=

# Email Delivery Service
# Supported EMAIL_PROVIDER values: 'resend', 'sendgrid', 'smtp', 'console'
EMAIL_PROVIDER=console
EMAIL_FROM="SetuGov Platform <noreply@setugov.gov.in>"
EMAIL_API_KEY=your_resend_or_sendgrid_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_SECURE=false
