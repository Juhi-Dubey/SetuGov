# SetuGov Backend Environment Configuration
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/setugov_db?schema=public"
JWT_SECRET="setugov_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"
AI_SERVICE_URL="http://localhost:8000"
AI_MOCK_MODE=true
NODE_ENV="development"
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Ollama & Embeddings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_EMBEDDING_DIMENSION="768"

# Anti-Abuse & Rate Limiting
AUTH_RATE_LIMIT_MAX=15
AUTH_RATE_LIMIT_WINDOW_MS=900000
INVITATION_RATE_LIMIT_MAX=20
INVITATION_RATE_LIMIT_WINDOW_MS=900000
ACCESS_REQUEST_RATE_LIMIT_MAX=5
ACCESS_REQUEST_RATE_LIMIT_WINDOW_MS=3600000

# Cloudflare Turnstile CAPTCHA (disabled in local dev, enabled in production)
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=

# Real Email Delivery Service
# Supported EMAIL_PROVIDER values: 'resend', 'sendgrid', 'smtp', 'console'
# For local dev real delivery with Resend:
#   EMAIL_PROVIDER=resend
#   EMAIL_API_KEY=re_your_api_key_here
#   EMAIL_FROM="SetuGov <onboarding@resend.dev>"
# For local dev real delivery with SMTP:
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_app_password
#   SMTP_SECURE=false
#   EMAIL_FROM="SetuGov Platform <your_email@gmail.com>"
EMAIL_PROVIDER=console
EMAIL_FROM="SetuGov Platform <noreply@setugov.gov.in>"
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
