# SetuGov AI Service — Environment Configuration
# Copy this file to .env and fill in your values.

# AI Provider Configuration — fully generic, no vendor assumed.
# AI_PROVIDER selects the ADAPTER, not a vendor:
#   "mock"           -> no network calls; safe default for local dev/tests
#   "api_compatible" -> any endpoint speaking the chat-completions convention
#                       (OpenAI-compatible gateways, most managed APIs, and
#                       Ollama's own /v1/chat/completions surface)
#   "ollama_native"  -> Ollama's native /api/generate endpoint
AI_PROVIDER=

# Required when AI_PROVIDER=api_compatible or ollama_native.
# Example for a local Ollama install via its native API:
#   AI_BASE_URL=http://localhost:11434
#   AI_MODEL=llama3.2:3b
#   AI_PROVIDER=ollama_native
# Example for a local Ollama install via its OpenAI-compatible API:
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.2:3b
#   AI_PROVIDER=api_compatible
# Example for a cloud/managed OpenAI-compatible endpoint:
#   AI_BASE_URL=https://your-provider-endpoint.example.com/v1
#   AI_MODEL=your-model-name
#   AI_API_KEY=your-api-key
#   AI_PROVIDER=api_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=

# Embedding Provider Configuration — deliberately separate from the chat
# settings above, since embeddings are usually a different model (and
# often a different vendor) entirely.
# EMBEDDING_PROVIDER selects the ADAPTER, not a vendor:
#   "mock"           -> no network calls; safe default for local dev/tests
#   "api_compatible" -> any endpoint speaking the /embeddings convention
#                       (OpenAI-compatible gateways, most managed embedding
#                       APIs) — recommended for production: a cloud call is
#                       typically far faster than a local model
#   "ollama_native"  -> Ollama's native /api/embed endpoint
#
# Example — OpenAI (or any OpenAI-compatible embeddings API):
#   EMBEDDING_PROVIDER=api_compatible
#   EMBEDDING_BASE_URL=https://api.openai.com/v1
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_API_KEY=your-api-key
#
# EMBEDDING_DIMENSION must match the fixed-width vector(N) column in
# Postgres (Backend/prisma/schema.prisma) — defaults to 768 to match the
# existing schema. If your chosen model's native output is a different
# size, you have two options instead of a database migration:
#   1. Set EMBEDDING_REQUEST_DIMENSIONS=true — for models that support an
#      OpenAI-style "dimensions" request parameter (e.g. text-embedding-3-
#      small/large), this truncates their output to EMBEDDING_DIMENSION.
#   2. Migrate the Postgres vector(N) columns (Challenge.embedding,
#      Startup.embedding) to the new model's native size, and update
#      Backend's AI_EMBEDDING_DIMENSION to match.
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT=
EMBEDDING_DIMENSION=
EMBEDDING_REQUEST_DIMENSIONS=

# AI Service Configuration
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Logging
LOG_LEVEL=INFO

# Request limits (optional — defaults shown)
MAX_INPUT_CHARS=20000
MAX_LIST_ITEMS=200
MAX_REQUEST_BYTES=1000000
